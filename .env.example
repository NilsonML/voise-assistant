# Скопируй в .env и заполни. Файл .env в git не попадает (.gitignore).
# Если .env нет, приложение само создаст пустой шаблон при первом запуске.

# OpenRouter API ключ (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Модель OpenRouter, например: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_MODEL=

# Голос и скорость озвучки (edge-tts)
EDGE_TTS_VOICE=ru-RU-SvetlanaNeural
EDGE_TTS_RATE=+0%
